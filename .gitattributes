# 统一换行符：仓库内一律使用 LF，避免 Windows 下提交产生整文件差异
* text=auto eol=lf

# 明确按文本处理的文件类型
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
